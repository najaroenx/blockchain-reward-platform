// =====================================================================
// FEAT-05 · Transfer Point · entity
// ตรงกับ db/migration.sql ทุกคอลัมน์ · ชื่อใน DB เป็น snake_case
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------- enum
enum OperationKind {
  MERCHANT_PROVISION
  POINT_TYPE_CREATE
  POINT_TRANSFER
  COUPON_TYPE_CREATE
  COUPON_ISSUE
  COUPON_REDEEM
  LISTING_CREATE
  LISTING_DELETE
  LISTING_BUY
  THB_MINT

  @@map("operation_kind")
}

enum OperationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FINALIZED
  CHAIN_REVERTED
  ORPHANED
  MANUAL_REVIEW

  @@map("operation_status")
}

enum StepStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FINALIZED
  CHAIN_REVERTED
  ORPHANED

  @@map("step_status")
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("merchant_status")
}

enum PointTypeStatus {
  REQUESTED
  LIVE
  FAILED
  RETIRED

  @@map("point_type_status")
}

enum HolderKind {
  MERCHANT
  CUSTOMER

  @@map("holder_kind")
}

/// RFD 9 Q4 · ชนิดที่เป็น "ของชิ้นเดียว" ถูกบังคับด้วย partial unique index
/// ส่วน POINT_BALANCE และ THB_BALANCE เป็นยอดที่บวกกันได้ จึงใช้ trigger ตรวจผลรวมแทน
enum ReservationSubject {
  POINT_BALANCE
  COUPON_UNIT
  LISTING
  THB_BALANCE
  ESCROW

  @@map("reservation_subject")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@map("ledger_direction")
}

enum ActorType {
  SYSTEM
  MERCHANT_ADMIN
  CUSTOMER
  PLATFORM_ADMIN

  @@map("actor_type")
}

// ---------------------------------------------- ตัวตน (FEAT-01 · FEAT-04)
model Merchant {
  id        String         @id
  name      String
  status    MerchantStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  pointTypes PointType[]

  @@map("merchant")
}

model Customer {
  id        String   @id
  telHash   Bytes    @map("tel_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([telHash], map: "uq_customer_tel")
  @@map("customer")
}

model Wallet {
  id        String   @id
  address   Bytes
  keyRef    String   @map("key_ref")
  ownerKind String   @map("owner_kind")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([address], map: "uq_wallet_address")
  @@unique([ownerKind, ownerId], map: "uq_wallet_owner")
  @@map("wallet")
}

model Signer {
  address   Bytes   @id
  keyRef    String  @map("key_ref")
  nextNonce BigInt  @default(0) @map("next_nonce")
  enabled   Boolean @default(true)

  steps OperationStep[]

  @@map("signer")
}

model PointType {
  id         String          @id
  merchantId String          @map("merchant_id")
  name       String
  symbol     String
  decimals   Int             @db.SmallInt
  status     PointTypeStatus @default(REQUESTED)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant             @relation(fields: [merchantId], references: [id])
  chain    PointTypeChain?
  buckets  PointBalanceBucket[]
  ledger   LedgerEntry[]

  @@map("point_type")
}

/// ค่าคงที่ของ contract · ใช้คำนวณวันหมดอายุของทุก bucket (RFD 10)
model PointTypeChain {
  pointTypeId     String   @id @map("point_type_id")
  contractAddress Bytes    @map("contract_address")
  genesisAt       DateTime @map("genesis_at") @db.Timestamptz(6)
  epochSeconds    Int      @map("epoch_seconds")
  validityEpochs  Int      @map("validity_epochs")

  pointType PointType @relation(fields: [pointTypeId], references: [id])

  @@unique([contractAddress], map: "uq_point_chain_address")
  @@map("point_type_chain")
}

// =============================================== ยอด point แบบ bucket
/// RFD 10 · ไม่มีคอลัมน์ "ยอดคงเหลือ" ที่ไหนเลย · พิสูจน์ด้วย T20
///
/// ยอดที่ใช้ได้ = ผลรวม bucket ที่ expiresAt ยังไม่ถึง ลบด้วย reservation ที่ยังไม่ปล่อย
/// คำนวณตอน query ทุกครั้ง ด้วยฟังก์ชัน f_available_points ใน migration.sql
///
/// expiresAt เป็นฟังก์ชันบริสุทธิ์ของ (เวลาที่ได้รับ, ค่าคงที่ของ contract)
/// จึง rebuild projection กี่ครั้งก็ได้ค่าเดิม
model PointBalanceBucket {
  id          String     @id
  pointTypeId String     @map("point_type_id")
  holderKind  HolderKind @map("holder_kind")
  holderId    String     @map("holder_id")
  epochIndex  Int        @map("epoch_index")
  /// RFD 14 · base units เสมอ
  amount      Decimal    @db.Decimal(78, 0)
  receivedAt  DateTime   @map("received_at") @db.Timestamptz(6)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  pointType PointType @relation(fields: [pointTypeId], references: [id])

  @@unique([pointTypeId, holderKind, holderId, epochIndex], map: "uq_bucket")
  @@index([pointTypeId, holderKind, holderId, expiresAt], map: "ix_bucket_live")
  @@map("point_balance_bucket")
}

/// บัญชีคู่ที่ derive จาก chain_event · ทุก operation ต้องมี DEBIT เท่ากับ CREDIT
model LedgerEntry {
  id           String          @id
  operationId  String?         @map("operation_id")
  pointTypeId  String          @map("point_type_id")
  holderKind   HolderKind      @map("holder_kind")
  holderId     String          @map("holder_id")
  direction    LedgerDirection
  amount       Decimal         @db.Decimal(78, 0)
  chainEventId String?         @map("chain_event_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  pointType PointType  @relation(fields: [pointTypeId], references: [id])
  operation Operation? @relation(fields: [operationId], references: [id])

  @@index([pointTypeId, holderKind, holderId], map: "ix_ledger_holder")
  @@index([operationId], map: "ix_ledger_operation")
  @@map("ledger_entry")
}

// --------------------------------------------- Group B · แกน write path
model IdempotencyKey {
  id             String    @id
  scope          String
  key            String
  fingerprint    Bytes
  operationId    String?   @map("operation_id")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  operation Operation? @relation(fields: [operationId], references: [id])

  @@unique([scope, key], map: "uq_idem")
  @@map("idempotency_key")
}

model Operation {
  id          String          @id
  actorScope  String          @map("actor_scope")
  kind        OperationKind
  status      OperationStatus @default(PENDING)
  subjectId   String?         @map("subject_id")
  payload     Json
  errorNote   String?         @map("error_note")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedAt DateTime?       @map("finalized_at") @db.Timestamptz(6)

  steps           OperationStep[]
  outbox          Outbox[]
  reservations    Reservation[]
  events          OperationEvent[]
  idempotencyKeys IdempotencyKey[]
  ledger          LedgerEntry[]
  chainEvents     ChainEvent[]

  @@index([createdAt], map: "ix_operation_open")
  @@map("operation")
}

/// โอนเป็นชุด = หนึ่ง operation หลาย step · หนึ่ง step = หนึ่ง tx
/// recipientCount จำกัดที่ 100 เพราะเกินกว่านั้น gas ต่อ tx เกิน block limit
model OperationStep {
  id             String     @id
  operationId    String     @map("operation_id")
  stepIndex      Int        @map("step_index")
  name           String
  recipientCount Int        @default(1) @map("recipient_count")
  signerAddress  Bytes?     @map("signer_address")
  nonce          BigInt?
  /// RFD 2 R2 · ต้อง COMMIT ก่อน broadcast เสมอ
  rawTx          Bytes?     @map("raw_tx")
  txHash         Bytes?     @map("tx_hash")
  status         StepStatus @default(PENDING)
  submittedAt    DateTime?  @map("submitted_at") @db.Timestamptz(6)
  confirmedAt    DateTime?  @map("confirmed_at") @db.Timestamptz(6)
  finalizedAt    DateTime?  @map("finalized_at") @db.Timestamptz(6)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  signer    Signer?   @relation(fields: [signerAddress], references: [address])

  @@unique([operationId, stepIndex], map: "uq_step_order")
  @@unique([txHash], map: "uq_step_txhash")
  @@unique([signerAddress, nonce], map: "uq_signer_nonce")
  @@map("operation_step")
}

model Outbox {
  id          String    @id
  operationId String    @map("operation_id")
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "idx_outbox_pending")
  @@map("outbox")
}

/// สอง trigger ใน migration.sql คุมตารางนี้
///   trg_point_reservation_balance   · จองเกินยอดที่ใช้ได้ไม่ได้
///   trg_reservation_release_timing  · ปล่อยจองก่อนงานจบไม่ได้
/// Prisma ประกาศ trigger และ partial index ไม่ได้ จึงอยู่ใน migration.sql เท่านั้น
model Reservation {
  id          String             @id
  operationId String             @map("operation_id")
  subjectType ReservationSubject @map("subject_type")
  /// POINT_BALANCE ใช้รูปแบบ <pointTypeId>|<holderKind>|<holderId>
  subjectId   String             @map("subject_id")
  amount      Decimal            @db.Decimal(78, 0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime?          @map("released_at") @db.Timestamptz(6)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId], map: "ix_reservation_open")
  @@map("reservation")
}

model OperationEvent {
  id          String           @id
  operationId String           @map("operation_id")
  fromStatus  OperationStatus? @map("from_status")
  toStatus    OperationStatus  @map("to_status")
  actor       ActorType        @default(SYSTEM)
  txHash      Bytes?           @map("tx_hash")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_event")
}

// -------------------------------------------- Group C · ฝั่งอ่าน chain
model ChainEvent {
  id             String    @id
  blockNumber    BigInt    @map("block_number")
  blockHash      Bytes     @map("block_hash")
  txHash         Bytes     @map("tx_hash")
  logIndex       Int       @map("log_index")
  address        Bytes
  topic0         Bytes
  topics         Json      @default("[]")
  data           Bytes
  blockTimestamp DateTime  @map("block_timestamp") @db.Timestamptz(6)
  operationId    String?   @map("operation_id")
  orphanedAt     DateTime? @map("orphaned_at") @db.Timestamptz(6)
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)

  operation Operation? @relation(fields: [operationId], references: [id])

  @@unique([txHash, logIndex], map: "uq_chain_event")
  @@map("chain_event")
}
